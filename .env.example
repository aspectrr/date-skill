# Date Ideas — Environment Variables
# Copy to .env and fill in. NEVER commit .env.

# ── TimeTree (read calendar to find free weekends) ──
TIMETREE_EMAIL=
TIMETREE_PASSWORD=
CALENDAR_ID=
# Your UTC offset (e.g. -5 for EST, -4 for EDT)
LOCAL_TZ_OFFSET_HOURS=

# ── Apify (deep venue/event discovery) ──
# Get one: https://console.apify.com/account/integrations
APIFY_TOKEN=

# ── Bark (v2: push booking nudges to phones) ──
BARK_KEY=
BARK_SERVER=
